<Window x:Class="LabirintusSzerkeszto_projekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabirintusSzerkeszto_projekt"
        mc:Ignorable="d"
        Title="Pálya szerkesztő" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200px"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="7px">
            <Button Name="NyelvGomb"
                    Content="English"
                    Click="NyelvValtas"
                    Width="50px"
                    />
            
            <Label Content="Magasság:" x:Name="magassagLb"/>
            <TextBox x:Name="magassagBox"/>

            <Label Content="Szélesség:" x:Name="szelessegLb"/>
            <TextBox Margin="0 0 0 20px" x:Name="szelessegBox"/>
        
            <Button Content="Pálya generálása" Click="Button_Click" x:Name="ujPalyaBtn"/>
            <Button Content="Pálya betöltése" Margin="0 20px 0 0" Click="PalyaBetoltese" x:Name="palyaBetoltesBtn"/>

            <Label Content="Válaszható elemek:" Margin="0 20px 0 0"/>

            <WrapPanel x:Name="valaszthatoElemek" />

            <Button Content="Mentés" Click="Mentes" x:Name="mentesBtn" Margin="0 10px 0 0"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <UniformGrid x:Name="PalyaGrid"/>
        </ScrollViewer>
    </Grid>
</Window>
