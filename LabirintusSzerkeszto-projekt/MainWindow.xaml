<Window x:Class="LabirintusSzerkeszto_projekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabirintusSzerkeszto_projekt"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200px"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="7px">
            <Label Content="Magasság:"/>
            <TextBox x:Name="magassagBox"/>

            <Label Content="Szélesség:"/>
            <TextBox Margin="0 0 0 20px" x:Name="szelessegBox"/>
        
            <Button Content="Pálya generálása" Click="Button_Click"/>

            <Label Content="Válaszható elemek:" Margin="0 20px 0 0"/>

            <WrapPanel x:Name="valaszthatoElemek" />

            <Button Content="Mentés" Click="Button_Click_1"/>
        </StackPanel>

        <ScrollViewer Grid.Column="1">
            <UniformGrid x:Name="PalyaGrid"/>
        </ScrollViewer>
    </Grid>
</Window>
